# Line-ending normalization.
#
# Adopted verbatim from the EGAV_MICROSERVICES root policy. This workspace is
# many separate repositories, so the root file reaches only the root - each
# repository needs its own copy or nothing normalizes it.
#
#
# WHY: this monorepo is edited on Windows but every backend runs in Linux
# containers, with shell scripts and supervisor/configs BIND-MOUNTED from
# the host. CRLF (\r\n) breaks `#!/bin/bash␍` shebangs ("bad interpreter")
# and supervisord.conf parsing. This file forces LF so containers get clean
# files — removing any need for runtime CRLF-stripping hacks in compose
# `command:` blocks or Dockerfiles.
#
# AFTER changing this file you must renormalize the working tree once:
#   git add --renormalize .
#   git commit -m "Normalize line endings to LF"
# (and ensure your editor saves LF — see .editorconfig if present).

# Default: detect text, store and check out as LF.
* text=auto eol=lf

# Files executed or parsed inside Linux containers — always LF.
*.sh        text eol=lf
*.bash      text eol=lf
*.conf      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.env       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
*.json      text eol=lf
*.py        text eol=lf
*.sql       text eol=lf
*.mjs       text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
Dockerfile      text eol=lf
Dockerfile*     text eol=lf
*.Dockerfile    text eol=lf
Makefile        text eol=lf
*.mk        text eol=lf

# Windows-only scripts keep CRLF.
*.ps1       text eol=crlf
*.psm1      text eol=crlf
*.psd1      text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary assets — never touch.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.tgz   binary
*.whl   binary
*.pyc   binary
*.pem   binary
*.crt   binary
*.key   binary
*.p12   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
